{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Compass news intelligence collection",
  "type": "object",
  "required": ["reviewed", "methodVersion", "categoryDefaults", "explicit", "method"],
  "properties": {
    "reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "methodVersion": {"type": "string"},
    "categoryDefaults": {"type": "object"},
    "explicit": {"type": "object"},
    "method": {
      "type": "object",
      "required": ["title", "principles", "note"],
      "properties": {
        "title": {"type": "string"},
        "principles": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    }
  }
}
