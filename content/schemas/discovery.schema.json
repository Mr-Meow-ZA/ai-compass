{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Compass discovery collection",
  "type": "object",
  "required": ["reviewed", "tools", "models", "courses", "resources"],
  "properties": {
    "reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "tools": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "name", "provider", "bestFor", "level", "type", "url", "sourceUrl", "watch", "tags"],
        "properties": {
          "id": {"type": "string"}, "name": {"type": "string"}, "provider": {"type": "string"},
          "bestFor": {"type": "string"}, "level": {"type": "string"}, "type": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"}, "sourceUrl": {"type": "string", "pattern": "^https://"},
          "watch": {"type": "string"}, "tags": {"type": "array", "minItems": 2, "items": {"type": "string"}}
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "name", "provider", "access", "bestFor", "openness", "url", "watch", "tags"],
        "properties": {
          "id": {"type": "string"}, "name": {"type": "string"}, "provider": {"type": "string"},
          "access": {"type": "string"}, "bestFor": {"type": "string"}, "openness": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"}, "watch": {"type": "string"},
          "tags": {"type": "array", "minItems": 2, "items": {"type": "string"}}
        }
      }
    },
    "courses": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "title", "provider", "level", "audience", "duration", "cost", "certificate", "url", "sourceUrl", "rating", "why", "value", "skip", "path", "verified"],
        "properties": {
          "id": {"type": "string"}, "title": {"type": "string"}, "provider": {"type": "string"},
          "level": {"type": "string"}, "audience": {"type": "string"}, "duration": {"type": "string"},
          "cost": {"type": "string"}, "certificate": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"}, "sourceUrl": {"type": "string", "pattern": "^https://"},
          "rating": {"type": "number"}, "why": {"type": "string"}, "value": {"type": "string"},
          "skip": {"type": "string"}, "path": {"type": "string"},
          "verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "audience", "summary", "href", "source", "tags"],
        "properties": {
          "id": {"type": "string"}, "title": {"type": "string"}, "type": {"type": "string"},
          "audience": {"type": "string"}, "summary": {"type": "string"}, "href": {"type": "string"},
          "source": {"type": "string"}, "tags": {"type": "array", "minItems": 2, "items": {"type": "string"}}
        }
      }
    }
  }
}
