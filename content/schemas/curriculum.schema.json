{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Compass curriculum collection",
  "type": "object",
  "required": ["version", "reviewed", "promise", "powerUserPath", "levels", "pathMeta"],
  "properties": {
    "version": {"type": "string"},
    "reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "promise": {"type": "string"},
    "powerUserPath": {
      "type": "object",
      "required": ["id", "title", "audience", "duration", "description", "accent", "steps"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"}, "audience": {"type": "string"},
        "duration": {"type": "string"}, "description": {"type": "string"}, "accent": {"type": "string"},
        "steps": {"type": "array", "minItems": 6, "items": {"type": "string"}}
      }
    },
    "levels": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "number", "title", "stage", "description", "forWhom", "paths", "skills", "readyWhen"],
        "properties": {
          "id": {"type": "string"}, "number": {"type": "string"}, "title": {"type": "string"},
          "stage": {"type": "string"}, "description": {"type": "string"}, "forWhom": {"type": "string"},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "skills": {"type": "array", "minItems": 4, "items": {"type": "string"}},
          "readyWhen": {"type": "string"}
        }
      }
    },
    "pathMeta": {"type": "object"}
  }
}
